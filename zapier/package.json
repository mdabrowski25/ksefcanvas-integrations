{
  "name": "ksefcanvas-zapier",
  "version": "1.0.0",
  "description": "Zapier integration for KSeF Canvas: create and issue Polish e-invoices through KSeF and react to KSeF results.",
  "main": "index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest --runInBand",
    "validate": "npx --yes zapier-platform-cli@19.3.0 validate --without-style"
  },
  "dependencies": {
    "zapier-platform-core": "19.3.0"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "nock": "14.0.17"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "setupFiles": [
      "<rootDir>/test/no-network.js"
    ]
  }
}
